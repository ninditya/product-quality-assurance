{
  "name": "product-quality-assurance",
  "version": "1.0.0",
  "private": true,
  "description": "Risk-based UI, API and load tests for the Toolshop demo (practicesoftwaretesting.com)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:p1": "playwright test --grep @P1",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  }
}
