{
  "name": "product-quality-assurance",
  "version": "1.0.0",
  "private": true,
  "description": "Risk-based UI, API and load tests for the Toolshop demo (practicesoftwaretesting.com)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:postman": "newman run postman/toolshop-product-api.postman_collection.json -e postman/api-with-bugs.postman_environment.json",
    "test:smoke": "playwright test --grep @smoke",
    "test:p1": "playwright test --grep @P1",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:load": "k6 run --summary-export=load-tests/results/summary.json load-tests/products-list.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "newman": "6.2.1",
    "typescript": "5.9.3"
  }
}
