# Copy to .env to override. Without .env, playwright.config.ts falls back to this file.
# The accounts below are PUBLIC demo accounts listed in the official Toolshop documentation:
# https://testsmith-io.github.io/practice-software-testing/#/
# Never put real credentials in this file.
# With these defaults the suite runs; it does not mean every test passes (tests that find defects fail).

# Part A: UI under test and the API it talks to (used to derive expected prices and ratings)
UI_BASE_URL=https://practicesoftwaretesting.com
UI_API_URL=https://api.practicesoftwaretesting.com

# Part B: API under test (version 5 with intentional bugs)
API_BASE_URL=https://api-with-bugs.practicesoftwaretesting.com

# Demo customer "Jane Doe" (shared account: locks after 3 failed logins; never use it for negative login tests)
CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
CUSTOMER_PASSWORD=welcome01

# Demo admin (API tests only: deleting products the tests created)
ADMIN_EMAIL=admin@practicesoftwaretesting.com
ADMIN_PASSWORD=welcome01
